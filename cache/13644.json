{"key": "4889", "mpkey": "2179", "stat": "A", "schd": "A", "code": "GEOG 241", "section": "001", "crn": "13644", "title": "+*TRANSFORMING ENVIRONMENTAL CONFLICTS", "session_html": "Full Term (11 week; Fall/Winter/Spring/Summer) (09-23-2026 to 12-04-2026)", "hours_html": "3", "rpt_for_credit": "", "campus": "Oregon State - Corvallis", "sche_type_clss_fild": "Lecture", "inst_mthd": "In-Person Section", "grade_mode": "Normal Grading Mode", "status": "Open", "max_enroll": "39", "enrollment": "37", "ssbsect_seats_avail": "2", "waitlist_capacity": "3", "ssbsect_wait_count": "0", "ssbsect_wait_avail": "3", "cross_list_max_enroll": "", "xlist_wait_cap": "", "ssbxlst_seats_avail": "", "description": "Explores the geography of environmental conflicts; examines how social processes and institutions influence access and use of natural resources; and the social constructs from which difference, power, and oppression emerge. Applies the experiences of women, minority, and under-represented communities to contemplate more integrated, equitable and sustainable approaches to resources management, in the United States and beyond. Explores personal skills in transforming conflicts, as well as concepts of distributive, procedural, and restorative justice.", "registration_restrictions": "", "corequisites": "", "department_approval_required": "", "recommendations": "", "fees": "", "attribute_description": "<ul><li>Bacc Core -  Difference, Power, and Discrimination (CPDP)</li><li>Core Education - Difference, Power, &amp; Oppression: Foundations (CFDP)</li></ul>", "books_html": "No-cost: Course utilizes open educational resources, materials available through the library, or does not require any purchased materials.", "clssnotes": "<p><p><a href=\"http://oregonstate.edu/registrar/rtfiles/q.html?\n:&202701&GEOG&241&001&13644\" target=\"blank\">Textbooks</a></p>", "meeting_html": "<div class=\"meet\">TR 10am-11:20am<span class=\"meet-room-202701\"> in <a href=\"https://map.oregonstate.edu/?id