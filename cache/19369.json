{"key": "5516", "mpkey": "2033", "stat": "A", "schd": "A", "code": "HST 335", "section": "001", "crn": "19369", "title": "*NINETEENTH-CENTURY EUROPE", "session_html": "Full Term (11 week; Fall/Winter/Spring/Summer) (09-23-2026 to 12-04-2026)", "hours_html": "4", "rpt_for_credit": "", "campus": "Oregon State - Corvallis", "sche_type_clss_fild": "Lecture", "inst_mthd": "In-Person Section", "grade_mode": "Normal Grading Mode", "status": "Open", "max_enroll": "35", "enrollment": "32", "ssbsect_seats_avail": "3", "waitlist_capacity": "5", "ssbsect_wait_count": "0", "ssbsect_wait_avail": "5", "cross_list_max_enroll": "", "xlist_wait_cap": "", "ssbxlst_seats_avail": "", "description": "A thematic overview of the &quot;long&quot; nineteenth century, from the French Revolution (1789) to the outbreak of the first World War (1914): the industrial revolution and the class struggles that accompanied it; the growing importance of the nation in politics and culture; imperial expansion and Europeans' contacts with non-Europeans; urbanization; Darwinism and Social Darwinism; and the developments leading to the cataclysm of Europe's first &quot;modern&quot; war. Not offered every year. (H) (Bacc Core Course)", "registration_restrictions": "", "corequisites": "", "department_approval_required": "", "recommendations": "", "fees": "", "attribute_description": "<ul><li>Bacc Core, Perspectives - Western Culture (CPWC)</li><li>Liberal Arts Humanities Core (LACH)</li></ul>", "books_html": "", "clssnotes": "<p><p><a href=\"http://oregonstate.edu/registrar/rtfiles/q.html?\n:&202701&HST&335&001&19369\" target=\"blank\">Textbooks</a></p>", "meeting_html": "<div class=\"meet\">TR 12pm-1:50pm<span class=\"meet-room-202701\"> in <a href=\"https://map.oregonstate.edu/?id=2243#!m/1027569?share\" target=\"_blank\">MLM 123 - Milam Hall 123 (GP)</a></span><span class=\"meet-dates\"> (9/23 to 12/4)</span></div>", "exams_html": "", "instructordetail_html": "<div class=\"instructor-detail\">Kara Ritzheime