{"key": "8916", "mpkey": "2062", "stat": "F", "schd": "A", "code": "WLC 241", "section": "001", "crn": "16925", "title": "+*GRIMMS' FAIRY TALES", "session_html": "Full Term (11 week; Fall/Winter/Spring/Summer) (09-23-2026 to 12-04-2026)", "hours_html": "3", "rpt_for_credit": "", "campus": "Oregon State - Corvallis", "sche_type_clss_fild": "Lecture", "inst_mthd": "In-Person Section", "grade_mode": "Normal Grading Mode", "status": "Open", "max_enroll": "40", "enrollment": "40", "ssbsect_seats_avail": "0", "waitlist_capacity": "0", "ssbsect_wait_count": "0", "ssbsect_wait_avail": "0", "cross_list_max_enroll": "", "xlist_wait_cap": "", "ssbxlst_seats_avail": "", "description": "Explores Grimms\u2019 fairy tales in context along with a selection of popular adaptations through textual analysis and interpretation, with an emphasis on ecocritical approaches to fairy tales. Examines the perennial popularity of fairy tales as an opportunity to learn about the tales as a genre and create fairy tale adaptations for contemporary audiences that speak to and engage with contemporary issues\u2014especially climate change and environmental justice\u2014through discussion, guided research, written analyses, presentation, and creative work.", "registration_restrictions": "", "corequisites": "", "department_approval_required": "", "recommendations": "", "fees": "", "attribute_description": "<ul><li>Bacc Core, Perspectives - Western Culture (CPWC)</li><li>Core Education - Arts &amp; Humanities: General (CFAH)</li></ul>", "books_html": "No-cost: Course utilizes open educational resources, materials available through the library, or does not require any purchased materials.", "clssnotes": "<p><p><a href=\"http://oregonstate.edu/registrar/rtfiles/q.html?\n:&202701&WLC&241&001&16925\" target=\"blank\">Textbooks</a></p>", "meeting_html": "<div class=\"meet\">TR 12pm-1:20pm<span class=\"meet-room-202701\"> in <a href=\"https://map.oregonstate.edu/?id=2243#!m/1027600?share\" target=\"_blank\">