{"key": "4796", "mpkey": "21993", "stat": "F", "schd": "D", "code": "GEO 201", "section": "012", "crn": "13104", "title": "+*PHYSICAL GEOLOGY", "session_html": "Full Term (11 week; Fall/Winter/Spring/Summer) (09-23-2026 to 12-04-2026)", "hours_html": "0", "rpt_for_credit": "", "campus": "Oregon State - Corvallis", "sche_type_clss_fild": "Laboratory", "inst_mthd": "In-Person Section", "grade_mode": "Not Gradable", "status": "Open", "max_enroll": "13", "enrollment": "26", "ssbsect_seats_avail": "-13", "waitlist_capacity": "10", "ssbsect_wait_count": "0", "ssbsect_wait_avail": "10", "cross_list_max_enroll": "", "xlist_wait_cap": "", "ssbxlst_seats_avail": "", "description": "Explores earth materials and processes that originate in Earth\u2019s interior and their societal relevance. Studies minerals, igneous, sedimentary, and metamorphic rocks, the processes that form them, and the geologic settings where they are found. Examines science concepts and theories including earth\u2019s structure, tectonic cycle, rock cycle, and crustal deformation. Considers consequences of tectonic activity including earthquakes and volcanic eruptions for daily life and decision making. Uses the process of science in active learning activities to develop comprehension and insight.", "registration_restrictions": "", "corequisites": "", "department_approval_required": "", "recommendations": "", "fees": "", "attribute_description": "<ul><li>Bacc Core, Perspectives  - Physical Science (CPPS)</li><li>Core Education - Scientific Inquiry &amp; Analysis (CFSI)</li></ul>", "books_html": "", "clssnotes": "<p>Field trip: Saturday, October 24, 9:00am to 4:00pm.\n<p><a href=\"http://oregonstate.edu/registrar/rtfiles/q.html?\n:&202701&GEO&201&012&13104\" target=\"blank\">Textbooks</a></p>", "meeting_html": "<div class=\"meet\">F 11am-12:50pm<span class=\"meet-room-202701\"> in <a href=\"https://map.oregonstate.edu/?id=2243#!m/1027616?share\" target=\"_blank\">WLKN 010 - Wilkinson Hall 010</a></span><spa