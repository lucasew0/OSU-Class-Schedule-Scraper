{"key": "557", "mpkey": "2090", "stat": "A", "schd": "A", "code": "ARE 310", "section": "001", "crn": "14763", "title": "ARCHITECTURE STUDIO", "session_html": "Full Term (11 week; Fall/Winter/Spring/Summer) (09-23-2026 to 12-04-2026)", "hours_html": "4", "rpt_for_credit": "", "campus": "Oregon State - Corvallis", "sche_type_clss_fild": "Lecture", "inst_mthd": "In-Person Section", "grade_mode": "Normal Grading Mode", "status": "Open", "max_enroll": "48", "enrollment": "47", "ssbsect_seats_avail": "1", "waitlist_capacity": "0", "ssbsect_wait_count": "0", "ssbsect_wait_avail": "0", "cross_list_max_enroll": "", "xlist_wait_cap": "", "ssbxlst_seats_avail": "", "description": "Introduces basic concepts, methods, and skills of architectural design in a project-based studio environment. Emphasizes recognition of design as a process, not a product, including the roles of divergent thinking and iteration. Explores concepts of circulation, structure, space, air, and light will be explored, focusing on integration of architectural and engineering design principles. Explores various ways to represent and present ideas, such as with hand sketches, computer drawing, and physical and digital models.", "registration_restrictions": "<p class=\"cls\">Enrollment limited to students with a term class standing of Junior or Senior.</p><p class=\"maj\">Enrollment is limited to students with a program in Architectural Engineering (826).</p>", "corequisites": "", "department_approval_required": "", "recommendations": "", "fees": "", "attribute_description": "", "books_html": "", "clssnotes": "<p><p><a href=\"http://oregonstate.edu/registrar/rtfiles/q.html?\n:&202701&ARE&310&001&14763\" target=\"blank\">Textbooks</a></p>", "meeting_html": "<div class=\"meet\">MW 2pm-3:50pm<span class=\"meet-room-202701\"> in <a href=\"https://map.oregonstate.edu/?id=2243#!m/1027585?share\" target=\"_blank\">OWEN 241 - Owen Hall 241</a></span><span class=\"meet-dates\"> (9/23 to 12/4)</span></div>", "exams_htm