{"key": "2294", "mpkey": "4809", "stat": "A", "schd": "H", "code": "CLIM 295", "section": "001", "crn": "13925", "title": "OBSERVING CLIMATE", "session_html": "Term Extension (2-Week Pre-Term) (09-09-2026 to 09-22-2026)", "hours_html": "3", "rpt_for_credit": "", "campus": "Oregon State - Corvallis", "sche_type_clss_fild": "Activity", "inst_mthd": "In-Person Section", "grade_mode": "Normal Grading Mode", "status": "Open", "max_enroll": "16", "enrollment": "9", "ssbsect_seats_avail": "7", "waitlist_capacity": "5", "ssbsect_wait_count": "0", "ssbsect_wait_avail": "5", "cross_list_max_enroll": "", "xlist_wait_cap": "", "ssbxlst_seats_avail": "", "description": "Explores various climate-related variables in the environment, emphasizing hands-on experiences and team-based observations. Deploys relevant instruments in collaborative teams. Documents procedures and assesses sources of uncertainty in measurement processes. Integrates qualitative and quantitative scientific observations, synthesizing them with theoretical concepts. Aims to decolonialize concepts of climate observations and foster inclusion across disciplines and cultures.", "registration_restrictions": "<p class=\"prereq\">Prerequisites: <a href=\"/search/?p=ATS%20201\" data-action=\"result-detail\" data-group=\"code:ATS 201\"  class=\"notoffered\">ATS 201</a>, <a href=\"/search/?p=ATS%20310\" data-action=\"result-detail\" data-group=\"code:ATS 310\"  class=\"notoffered\">310</a>, <a href=\"/search/?p=CLIM%20201\" data-action=\"result-detail\" data-group=\"code:CLIM 201\" >CLIM 201</a> or <a href=\"/search/?p=CLIM%20217\" data-action=\"result-detail\" data-group=\"code:CLIM 217\" >217</a>.<br/>A minimum grade of C- is required in <a href=\"/search/?p=ATS%20201\" data-action=\"result-detail\" data-group=\"code:ATS 201\"  class=\"notoffered\">ATS 201</a>, <a href=\"/search/?p=ATS%20310\" data-action=\"result-detail\" data-group=\"code:ATS 310\"  class=\"notoffered\">ATS 310</a>, <a href=\"/search/?p=CLIM%20201\" data-action=\"result-detail\" data-group=\"code:CLIM 201\" >CLIM 201</a> and <a href=\"/search/?p=CLIM%20217\" data-action=\"result-detail\" data-group=\"code:CLIM 217\" >CLIM 217</a>.</p>", "corequisites": "", "department_approval_required": "SAPR-Department Approval", "recommendations": "", "fees": "FGS2 - $390.00 Flat Fee", "attribute_description": "", "books_html": "", "clssnotes": "<p>CLIM 295 is a field observations course.  \nWe will spend the majority of September 16-22\naway from Corvallis at various sites.\nThe class will hold a pre-trip planning / logistics meeting \non Wednesday, May 27th also at 4:30 in Strand Hall 313.  \nPlease notify the instructor if you cannot attend \nin person and \nremote or asynchronous details will be provided.\nFor registration override contact your advisor. \n For additional course information contact the instructor \nat justin.wettstein@oregonstate.edu\n<p><a href=\"http://oregonstate.edu/registrar/rtfiles/q.html?\n:&202701&CLIM&295&001&13925\" target=\"blank\">Textbooks</a></p>", "meeting_html": "<div class=\"meet\">MTWRFSU 8am-5:50pm<span class=\"meet-room-202701\"> in *Off Campus Location (GRP OC)</span><span class=\"meet-dates\"> (9/9 to 9/22)</span></div>", "exams_html": "", "instructordetail_html": "<div class=\"instructor-detail\">Justin Wettstein</div>", "all_sections": "<div class=\"course-sections\" role=\"grid\" aria-readonly=\"true\"><div role=\"row\"><div role=\"columnheader\" scope=\"col\">CRN</div><div role=\"columnheader\" scope=\"col\">Section #</div><div role=\"columnheader\" scope=\"col\">Campus</div><div role=\"columnheader\" scope=\"col\">Meets</div><div role=\"columnheader\" scope=\"col\">Type</div><div role=\"columnheader\" scope=\"col\">Max Enrl</div><div role=\"columnheader\" scope=\"col\">Actual Enrl</div></div><a role=\"row\" href=\"#\" class=\"course-section\" data-action=\"result-detail\" data-group=\"code:CLIM 295\" data-srcdb=\"202701\" data-key=\"crn:13925\"><div role=\"rowheader\" class=\"c