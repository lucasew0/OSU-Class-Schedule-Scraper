{"key": "4234", "mpkey": "2056", "stat": "F", "schd": "A", "code": "FES 341", "section": "001", "crn": "12016", "title": "FOREST ECOLOGY", "session_html": "Full Term (11 week; Fall/Winter/Spring/Summer) (09-23-2026 to 12-04-2026)", "hours_html": "3", "rpt_for_credit": "", "campus": "Oregon State - Corvallis", "sche_type_clss_fild": "Lecture", "inst_mthd": "In-Person Section", "grade_mode": "Normal Grading Mode", "status": "Open", "max_enroll": "52", "enrollment": "58", "ssbsect_seats_avail": "-6", "waitlist_capacity": "20", "ssbsect_wait_count": "0", "ssbsect_wait_avail": "20", "cross_list_max_enroll": "", "xlist_wait_cap": "", "ssbxlst_seats_avail": "", "description": "Examines fundamentals of forest ecosystems, including factors that influence forest composition, structure, and function over space and time. Covers principles of social-ecological forest systems, species traits, species interactions, forest disturbance-succession cycles, community ecology and biodiversity, invasion ecology, landscape ecology, adaptation and transformation in forest ecosystems. Presents topics in the context of understanding a global array of forest ecosystems and considering issues in their management from multiple perspectives.", "registration_restrictions": "<p class=\"prereq\">Prerequisites: <a href=\"/search/?p=FES%20240\" data-action=\"result-detail\" data-group=\"code:FES 240\" >FES 240</a> or <a href=\"/search/?p=FES%20240H\" data-action=\"result-detail\" data-group=\"code:FES 240H\"  class=\"notoffered\">240H</a> or ((<a href=\"/search/?p=BI%20221Z\" data-action=\"result-detail\" data-group=\"code:BI 221Z\" >BI 221Z</a> or 221HZ) and (<a href=\"/search/?p=BI%20222Z\" data-action=\"result-detail\" data-group=\"code:BI 222Z\"  class=\"notoffered\">BI 222Z</a> or 222HZ) and (<a href=\"/search/?p=BI%20223Z\" data-action=\"result-detail\" data-group=\"code:BI 223Z\"  class=\"notoffered\">BI 223Z</a> or 223HZ)) or ((<a href=\"/search/?p=BI%20221\" data-action=\"result-detail\" dat