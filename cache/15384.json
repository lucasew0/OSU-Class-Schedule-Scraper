{"key": "381", "mpkey": "2056", "stat": "F", "schd": "A", "code": "ANS 380", "section": "001", "crn": "15384", "title": "PRINCIPLES OF ANIMAL ANATOMY AND PHYSIOLOGY", "session_html": "Full Term (11 week; Fall/Winter/Spring/Summer) (09-23-2026 to 12-04-2026)", "hours_html": "3", "rpt_for_credit": "", "campus": "Oregon State - Corvallis", "sche_type_clss_fild": "Lecture", "inst_mthd": "In-Person Section", "grade_mode": "Normal Grading Mode", "status": "Open", "max_enroll": "80", "enrollment": "80", "ssbsect_seats_avail": "0", "waitlist_capacity": "10", "ssbsect_wait_count": "0", "ssbsect_wait_avail": "10", "cross_list_max_enroll": "", "xlist_wait_cap": "", "ssbxlst_seats_avail": "", "description": "An introductory course in animal anatomy to provide a foundation for advanced courses in the Animal Science curriculum. Emphasis is on acquisition of a basic knowledge of minute and gross anatomical structures, their operation, and integration. Begins with anatomical nomenclature such as body planes and directional terms then covers the following tissues and organ systems: epithelium, connective tissue, blood and bone marrow, bone/cartilage, muscle tissue, nervous tissue, digestive system, circulatory system, reproductive system, urinary system, and respiratory system.", "registration_restrictions": "<p class=\"prereq\">Prerequisites: ((<a href=\"/search/?p=BI%20221Z\" data-action=\"result-detail\" data-group=\"code:BI 221Z\" >BI 221Z</a> or 221HZ) and (<a href=\"/search/?p=BI%20222Z\" data-action=\"result-detail\" data-group=\"code:BI 222Z\"  class=\"notoffered\">BI 222Z</a> or 222HZ) and (<a href=\"/search/?p=BI%20223Z\" data-action=\"result-detail\" data-group=\"code:BI 223Z\"  class=\"notoffered\">BI 223Z</a> or 223HZ)) or ((<a href=\"/search/?p=BI%20221\" data-action=\"result-detail\" data-group=\"code:BI 221\" >BI 221</a> or <a href=\"/search/?p=BI%20221H\" data-action=\"result-detail\" data-group=\"code:BI 221H\"  class=\"notoffered\">221H</a>) and (<a href=\"/search/?p=BI%20222\" data-action=\"result-detail\" data-group=\"code:BI 222\"  class=\"notoffered\">BI 222</a> or <a href=\"/search/?p=BI%20222H\" data-action=\"result-detail\" data-group=\"code:BI 222H\"  class=\"notoffered\">222H</a>) and (<a href=\"/search/?p=BI%20223\" data-action=\"result-detail\" data-group=\"code:BI 223\"  class=\"notoffered\">BI 223</a> or <a href=\"/search/?p=BI%20223H\" data-action=\"result-detail\" data-group=\"code:BI 223H\"  class=\"notoffered\">223H</a>)) or (<a href=\"/search/?p=BI%20204\" data-action=\"result-detail\" data-group=\"code:BI 204\" >BI 204</a>, <a href=\"/search/?p=BI%20205\" data-action=\"result-detail\" data-group=\"code:BI 205\"  class=\"notoffered\">205</a> and <a href=\"/search/?p=BI%20206\" data-action=\"result-detail\" data-group=\"code:BI 206\" >206</a>).<br/>A minimum grade of D is required in <a href=\"/search/?p=BI%20221Z\" data-action=\"result-detail\" data-group=\"code:BI 221Z\" >BI 221Z</a>, <a href=\"/search/?p=BI%20221HZ\" data-action=\"result-detail\" data-group=\"code:BI 221HZ\" >BI 221HZ</a>, <a href=\"/search/?p=BI%20222Z\" data-action=\"result-detail\" data-group=\"code:BI 222Z\"  class=\"notoffered\">BI 222Z</a>, <a href=\"/search/?p=BI%20222HZ\" data-action=\"result-detail\" data-group=\"code:BI 222HZ\"  class=\"notoffered\">BI 222HZ</a>, <a href=\"/search/?p=BI%20223Z\" data-action=\"result-detail\" data-group=\"code:BI 223Z\"  class=\"notoffered\">BI 223Z</a>, <a href=\"/search/?p=BI%20223HZ\" data-action=\"result-detail\" data-group=\"code:BI 223HZ\"  class=\"notoffered\">BI 223HZ</a>, <a href=\"/search/?p=BI%20221\" data-action=\"result-detail\" data-group=\"code:BI 221\" >BI 221</a>, <a href=\"/search/?p=BI%20221H\" data-action=\"result-detail\" data-group=\"code:BI 221H\"  class=\"notoffered\">BI 221H</a>, <a href=\"/search/?p=BI%20222\" data-action=\"result-detail\" data-group=\"code:BI 222\"  class=\"notoffered\">BI 222</a>, <a href=\"/search/?p=BI%20222H\" data-action=\"result-detail\" data-grou