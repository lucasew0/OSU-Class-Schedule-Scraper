{"key": "2765", "mpkey": "2100", "stat": "A", "schd": "A", "code": "CS 453", "section": "001", "crn": "13207", "title": "SCIENTIFIC VISUALIZATION", "session_html": "Full Term (11 week; Fall/Winter/Spring/Summer) (09-23-2026 to 12-04-2026)", "hours_html": "4", "rpt_for_credit": "", "campus": "Oregon State - Corvallis", "sche_type_clss_fild": "Lecture", "inst_mthd": "In-Person Section", "grade_mode": "Normal Grading Mode", "status": "Open", "max_enroll": "35", "enrollment": "20", "ssbsect_seats_avail": "15", "waitlist_capacity": "10", "ssbsect_wait_count": "0", "ssbsect_wait_avail": "10", "cross_list_max_enroll": "", "xlist_wait_cap": "", "ssbxlst_seats_avail": "", "description": "Applies 3D computer graphics methods to visually understand scientific and engineering data. Methods include hyperbolic projections; mapping scalar values to color spaces; data visualization using range sliders; scalar visualization (point clouds, cutting planes, contour plots, isosurfaces); vector visualization (arrow clouds, particle advection, streamlines); terrain visualization; Delauney triangulation; and volume visualization.", "registration_restrictions": "<p class=\"prereq\">Prerequisites: <a href=\"/search/?p=CS%20261\" data-action=\"result-detail\" data-group=\"code:CS 261\" >CS 261</a> or <a href=\"/search/?p=CS%20261H\" data-action=\"result-detail\" data-group=\"code:CS 261H\"  class=\"notoffered\">261H</a>.<br/>A minimum grade of C is required in <a href=\"/search/?p=CS%20261\" data-action=\"result-detail\" data-group=\"code:CS 261\" >CS 261</a> and <a href=\"/search/?p=CS%20261H\" data-action=\"result-detail\" data-group=\"code:CS 261H\"  class=\"notoffered\">CS 261H</a>.</p><p class=\"maj\">Enrollment is limited to students with a program in Computer Science (307).</p><p class=\"col\">Enrollment limited to students in the College of Engineering college.</p>", "corequisites": "", "department_approval_required": "", "recommendations": "Prior experience with Unix or Windows, prog