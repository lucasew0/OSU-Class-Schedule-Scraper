{"key": "1610", "mpkey": "2346", "stat": "A", "schd": "A", "code": "CE 420", "section": "001", "crn": "11919", "title": "ENGINEERING PLANNING", "session_html": "Full Term (11 week; Fall/Winter/Spring/Summer) (09-23-2026 to 12-04-2026)", "hours_html": "4", "rpt_for_credit": "", "campus": "Oregon State - Corvallis", "sche_type_clss_fild": "Lecture", "inst_mthd": "In-Person Section", "grade_mode": "Normal Grading Mode", "status": "Open", "max_enroll": "80", "enrollment": "79", "ssbsect_seats_avail": "1", "waitlist_capacity": "0", "ssbsect_wait_count": "0", "ssbsect_wait_avail": "0", "cross_list_max_enroll": "", "xlist_wait_cap": "", "ssbxlst_seats_avail": "", "description": "The application of systems analysis to structuring, analyzing, and planning for civil engineering projects. Concept of the system and its environment; setting goals, objectives, and standards; evaluation criteria; solution generation and analysis; evaluation and optimization. Project management using precedence node diagramming; resource allocation and leveling; time-cost trade-off; and PERT. ", "registration_restrictions": "<p class=\"cls\">Enrollment limited to students with a term class standing of Junior or Senior.</p><p class=\"maj\">Enrollment is limited to students with a program in Civil Engineering (306) or Architectural Engineering (826).</p>", "corequisites": "", "department_approval_required": "", "recommendations": "", "fees": "", "attribute_description": "", "books_html": "No-cost: Course utilizes open educational resources, materials available through the library, or does not require any purchased materials.", "clssnotes": "<p><p><a href=\"http://oregonstate.edu/registrar/rtfiles/q.html?\n:&202701&CE&420&001&11919\" target=\"blank\">Textbooks</a></p>", "meeting_html": "<div class=\"meet\">TR 4pm-5:50pm<span class=\"meet-room-202701\"> in <a href=\"https://map.oregonstate.edu/?id=2243#!m/1027585?share\" target=\"_blank\">OWEN 102 - Owen Hall 102 (GP)</a></span><span class=\"meet-dates