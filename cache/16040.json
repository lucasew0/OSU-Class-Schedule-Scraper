 data-group=\"code:ECE 356\"  class=\"notoffered\">ECE 356</a>, <a href=\"/search/?p=ECE%20451\" data-action=\"result-detail\" data-group=\"code:ECE 451\"  class=\"notoffered\">ECE 451</a>, <a href=\"/search/?p=ME%20320\" data-action=\"result-detail\" data-group=\"code:ME 320\" >ME 320</a>, <a href=\"/search/?p=ME%20320H\" data-action=\"result-detail\" data-group=\"code:ME 320H\"  class=\"notoffered\">ME 320H</a>, <a href=\"/search/?p=ME%20430\" data-action=\"result-detail\" data-group=\"code:ME 430\"  class=\"notoffered\">ME 430</a> and <a href=\"/search/?p=ME%20430H\" data-action=\"result-detail\" data-group=\"code:ME 430H\"  class=\"notoffered\">ME 430H</a>.</p><p class=\"col\">Enrollment limited to students in the College of Engineering college.</p>", "corequisites": "", "department_approval_required": "", "recommendations": "", "fees": "", "attribute_description": "", "books_html": "No-cost: Course utilizes open educational resources, materials available through the library, or does not require any purchased materials.", "clssnotes": "<p><p><a href=\"http://oregonstate.edu/registrar/rtfiles/q.html?\n:&202701&ROB&417&001&16040\" target=\"blank\">Textbooks</a></p>", "meeting_html": "<div class=\"meet\">MW 2pm-3:50pm<span class=\"meet-room-202701\"> in <a href=\"https://map.oregonstate.edu/?id=2243#!m/1027589?share\" target=\"_blank\">COVL 221 - Covell Hall 221 (GP)</a></span><span class=\"meet-dates\"> (9/23 to 12/4)</span></div>", "exams_html": "", "instructordetail_html": "<div class=\"instructor-detail\">Ross Hatton</div>", "all_sections": "<div class=\"course-sections\" role=\"grid\" aria-readonly=\"true\"><div role=\"row\"><div role=\"columnheader\" scope=\"col\">CRN</div><div role=\"columnheader\" scope=\"col\">Section #</div><div role=\"columnheader\" scope=\"col\">Campus</div><div role=\"columnheader\" scope=\"col\">Meets</div><div role=\"columnheader\" scope=\"col\">Type</div><div role=\"columnheader\" scope=\"col\">Max Enrl</div><div role=\"columnheader