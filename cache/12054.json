Z</a>, 223HZ, <a href=\"/search/?p=BI%20223\" data-action=\"result-detail\" data-group=\"code:BI 223\"  class=\"notoffered\">223</a> or <a href=\"/search/?p=BI%20223H\" data-action=\"result-detail\" data-group=\"code:BI 223H\"  class=\"notoffered\">223H</a>)) or (<a href=\"/search/?p=BI%20204\" data-action=\"result-detail\" data-group=\"code:BI 204\" >BI 204</a>, <a href=\"/search/?p=BI%20205\" data-action=\"result-detail\" data-group=\"code:BI 205\"  class=\"notoffered\">205</a> and <a href=\"/search/?p=BI%20206\" data-action=\"result-detail\" data-group=\"code:BI 206\" >206</a>).<br/>A minimum grade of C- is required in <a href=\"/search/?p=BI%20221Z\" data-action=\"result-detail\" data-group=\"code:BI 221Z\" >BI 221Z</a>, <a href=\"/search/?p=BI%20221HZ\" data-action=\"result-detail\" data-group=\"code:BI 221HZ\" >BI 221HZ</a>, <a href=\"/search/?p=BI%20221\" data-action=\"result-detail\" data-group=\"code:BI 221\" >BI 221</a>, <a href=\"/search/?p=BI%20221H\" data-action=\"result-detail\" data-group=\"code:BI 221H\"  class=\"notoffered\">BI 221H</a>, <a href=\"/search/?p=BI%20222Z\" data-action=\"result-detail\" data-group=\"code:BI 222Z\"  class=\"notoffered\">BI 222Z</a>, <a href=\"/search/?p=BI%20222HZ\" data-action=\"result-detail\" data-group=\"code:BI 222HZ\"  class=\"notoffered\">BI 222HZ</a>, <a href=\"/search/?p=BI%20222\" data-action=\"result-detail\" data-group=\"code:BI 222\"  class=\"notoffered\">BI 222</a>, <a href=\"/search/?p=BI%20222H\" data-action=\"result-detail\" data-group=\"code:BI 222H\"  class=\"notoffered\">BI 222H</a>, <a href=\"/search/?p=BI%20223Z\" data-action=\"result-detail\" data-group=\"code:BI 223Z\"  class=\"notoffered\">BI 223Z</a>, <a href=\"/search/?p=BI%20223HZ\" data-action=\"result-detail\" data-group=\"code:BI 223HZ\"  class=\"notoffered\">BI 223HZ</a>, <a href=\"/search/?p=BI%20223\" data-action=\"result-detail\" data-group=\"code:BI 223\"  class=\"notoffered\">BI 223</a>, <a href=\"/search/?p=BI%20223H\" data-action=\"