{"key": "6213", "mpkey": "2104", "stat": "F", "schd": "HYB", "code": "MRKT 492", "section": "100", "crn": "11243", "title": "CONSUMER BEHAVIOR", "session_html": "Full Term (11 week; Fall/Winter/Spring/Summer) (09-23-2026 to 12-04-2026)", "hours_html": "4", "rpt_for_credit": "", "campus": "Oregon State - Corvallis", "sche_type_clss_fild": "Hybrid", "inst_mthd": "In-Person Section", "grade_mode": "Normal Grading Mode", "status": "Open", "max_enroll": "45", "enrollment": "45", "ssbsect_seats_avail": "0", "waitlist_capacity": "5", "ssbsect_wait_count": "0", "ssbsect_wait_avail": "5", "cross_list_max_enroll": "", "xlist_wait_cap": "", "ssbxlst_seats_avail": "", "description": "Understanding the processes that lead to purchase, so as to improve decisions on segmentation and the appropriate marketing mix for each segment. How consumers and households make decisions, and why different individuals/groups make different decisions. Application of behavioral science concepts at individual, subcultural and cultural levels. Effects of consumerism and regulation also are considered. ", "registration_restrictions": "<p class=\"prereq\">Prerequisites: <a href=\"/search/?p=BA%20223\" data-action=\"result-detail\" data-group=\"code:BA 223\" >BA 223</a>, <a href=\"/search/?p=BA%20223H\" data-action=\"result-detail\" data-group=\"code:BA 223H\"  class=\"notoffered\">223H</a>, <a href=\"/search/?p=BA%20390\" data-action=\"result-detail\" data-group=\"code:BA 390\" >390</a> or <a href=\"/search/?p=BA%20390H\" data-action=\"result-detail\" data-group=\"code:BA 390H\"  class=\"notoffered\">390H</a>.<br/>A minimum grade of C is required in <a href=\"/search/?p=BA%20223\" data-action=\"result-detail\" data-group=\"code:BA 223\" >BA 223</a>, <a href=\"/search/?p=BA%20223H\" data-action=\"result-detail\" data-group=\"code:BA 223H\"  class=\"notoffered\">BA 223H</a>, <a href=\"/search/?p=BA%20390\" data-action=\"result-detail\" data-group=\"code:BA 390\" >BA 390</a> and <a href=\"/search/?p=BA%20390H\" data-action=\"result-detail\" data-group=\"code:BA 390H\"  class=\"notoffered\">BA 390H</a>.</p><p class=\"cls\">Students with a term class standing of Freshman, Sophomore or Junior may <strong>not</strong> enroll.</p><p class=\"maj\">Enrollment is limited to students with a program in:<ul><li>Apparel Design (400)</li><li>Merchandising Management (416)</li><li>Interior Design (458)</li><li>Marketing (799)</li><li>Marketing (814)</li><li>Professional Sales (817)</li><li>Digital Marketing Analytics (903)</li><li>Market Res & Consumer Analytic (904)</li><li>Design & Innovation Management (912)</li><li>Product and Merchandising Mgmt (A014)</li><li>Applied AI in Business (A047)</li></ul></p>", "corequisites": "", "department_approval_required": "", "recommendations": "", "fees": "", "attribute_description": "", "books_html": "", "clssnotes": "<p>Hybrid section; both on-site meetings and online component.\n<p><a href=\"http://oregonstate.edu/registrar/rtfiles/q.html?\n:&202701&MRKT&492&100&11243\" target=\"blank\">Textbooks</a></p>", "meeting_html": "<div class=\"meet\">T 2pm-3:50pm<span class=\"meet-room-202701\"> in <a href=\"https://map.oregonstate.edu/?id=2243#!m/1027675?share\" target=\"_blank\">AUST 270 - Austin Hall 270</a></span><span class=\"meet-dates\"> (9/23 to 12/4)</span></div>", "exams_html": "", "instructordetail_html": "<div class=\"instructor-detail\">Inhwa Kim</div>", "all_sections": "<div class=\"course-sections\" role=\"grid\" aria-readonly=\"true\"><div role=\"row\"><div role=\"columnheader\" scope=\"col\">CRN</div><div role=\"columnheader\" scope=\"col\">Section #</div><div role=\"columnheader\" scope=\"col\">Campus</div><div role=\"columnheader\" scope=\"col\">Meets</div><div role=\"columnheader\" scope=\"col\">Type</div><div role=\"columnheader\" scope=\"col\">Max Enrl</div><div role=\"columnheader\" scope=\"col\">Actual Enrl</div></div><a role=\"row\" href=\"#\" class=\"course-section\" data-action=\"result-detail\" data-group=\"code:MRKT